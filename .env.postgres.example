# Шаблон .env.postgres для prod. Реальный файл лежит на сервере
# /opt/smeteora-api/.env.postgres и НИКОГДА не коммитится.
# Права: chmod 600, owner smeteora.
#
# Эти переменные читает docker-entrypoint.sh Postgres при первом запуске
# (на пустом volume). Пароли трёх ролей приложения читает наш
# docker/postgres-init.sh — тоже на первом запуске.
#
# ВАЖНО: пароли, заданные ниже, должны СОВПАДАТЬ с теми что в DATABASE_URL /
# DATABASE_URL_MIGRATOR в .env (иначе приложение не сможет подключиться).

# ── Postgres суперюзер (создаётся автоматически) ───────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_postgres_superuser_password
POSTGRES_DB=smeteora

# ── Пароли ролей приложения ────────────────────────────────────
# Роли создаются docker/postgres-init.sh при первом запуске.
SMETEORA_APP_PASSWORD=REPLACE_ME_app_password
SMETEORA_MIGRATOR_PASSWORD=REPLACE_ME_migrator_password
SMETEORA_PLATFORM_EDITOR_PASSWORD=REPLACE_ME_platform_editor_password
