# ── Runtime ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────────
# Список origins фронта через запятую (без trailing slash)
CORS_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────────────
# Рантайм-роль приложения. БЕЗ BYPASSRLS. Все запросы проходят через RLS.
DATABASE_URL=postgresql://smeteora_app:app_dev_password@localhost:5442/smeteora

# Роль для миграций. С BYPASSRLS. НЕ используется в рантайме.
# Только для локальной разработки и CI. В prod — из GitHub Secrets.
DATABASE_URL_MIGRATOR=postgresql://smeteora_migrator:migrator_dev_password@localhost:5442/smeteora

# Тестовая БД для интеграционных тестов (docker-compose поднимает на 5433).
DATABASE_URL_TEST=postgresql://smeteora_app:app_test_password@localhost:5433/smeteora_test
DATABASE_URL_TEST_MIGRATOR=postgresql://smeteora_migrator:migrator_test_password@localhost:5433/smeteora_test

# ── Sessions ────────────────────────────────────────────────────
# Секрет для подписи session-cookie. Обязательно ≥ 32 символа.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change_me_at_least_32_characters_long_secret_here

# TTL сессии в днях (sliding — обновляется на каждом запросе).
SESSION_TTL_DAYS=30

# Домен для cookie. В dev оставь пустым (cookie привязана к localhost).
# В prod — ".smeteora.ru" (с точкой в начале) чтобы работало на api.* и app.*.
# COOKIE_DOMAIN=

# ── Yandex OAuth ────────────────────────────────────────────────
# Регистрация приложения: https://oauth.yandex.ru/ → «Создать приложение».
# Redirect URI в кабинете должен точно совпадать с YANDEX_OAUTH_REDIRECT_URI ниже.
# В dev — оставь пустыми, эндпоинты /auth/yandex/* будут отвечать 503.
# Все пять переменных задаются целиком: либо все, либо ни одной.
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
# YANDEX_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/yandex/callback
# FRONTEND_OAUTH_SUCCESS_URL=http://localhost:5173/
# FRONTEND_OAUTH_ERROR_URL=http://localhost:5173/auth/error

# ── FileStorage ─────────────────────────────────────────────────
# Относительный путь резолвится от cwd. В prod (Docker) cwd=/app,
# монтируется на хостовой /opt/smeteora-api/data.
UPLOADS_DIR=./data/uploads
