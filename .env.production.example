# Шаблон .env для prod. Реальный файл лежит на сервере /opt/smeteora-api/.env
# и НИКОГДА не коммитится. Права на файл: chmod 600, owner smeteora.
#
# Значения ниже — placeholder'ы; реальные заполняются на сервере.

# ── Runtime ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────────
# Прод-домен фронта, без trailing slash. Несколько origin'ов — через запятую.
CORS_ORIGIN=https://smeteora.ru,https://www.smeteora.ru

# ── Database ────────────────────────────────────────────────────
# postgres — hostname сервиса в compose network.
# Пароли должны совпадать с теми что заданы в .env.postgres (secrets bootstrap Postgres).
DATABASE_URL=postgresql://smeteora_app:REPLACE_ME@postgres:5432/smeteora
DATABASE_URL_MIGRATOR=postgresql://smeteora_migrator:REPLACE_ME@postgres:5432/smeteora

# ── Sessions ────────────────────────────────────────────────────
# openssl rand -hex 32 → 64 hex-символа = 256 бит энтропии.
SESSION_SECRET=REPLACE_ME_at_least_32_characters_long_random_hex
SESSION_TTL_DAYS=30

# ── Cookie ──────────────────────────────────────────────────────
# С точкой впереди — cookie доступен на всех поддоменах smeteora.ru
# (нужен для того чтобы фронт на smeteora.ru отправлял session-cookie
# на api.smeteora.ru).
COOKIE_DOMAIN=.smeteora.ru
